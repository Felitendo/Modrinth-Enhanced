@@ -0,0 +1,47 @@
+<!--
+	A launcher's own logo, or its initials in a badge where the launcher does not
+	let its logo be passed on. See src/assets/launchers/README.md.
+-->
+<template>
+	<CurseForgeIcon v-if="name === 'CurseForge'" class="size-8 shrink-0 text-contrast" />
+	<img v-else-if="logo" :src="logo" :alt="''" class="size-8 shrink-0 rounded-lg" />
+	<span
+		v-else
+		class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-surface-4 text-xs font-extrabold text-contrast"
+		aria-hidden="true"
+	>
+		{{ mark }}
+	</span>
+</template>
+
+<script setup lang="ts">
+import { CurseForgeIcon } from '@modrinth/assets'
+import { computed } from 'vue'
+
+// As URLs, not as components: these are the launchers' own artwork, colours
+// and all, rather than an icon that takes the colour around it.
+import atlauncher from '../../../../assets/launchers/atlauncher.svg?url'
+import gdlauncher from '../../../../assets/launchers/gdlauncher.png'
+import polymc from '../../../../assets/launchers/polymc.svg?url'
+import prismLauncher from '../../../../assets/launchers/prism-launcher.svg?url'
+
+const props = defineProps<{ name: string }>()
+
+const LOGOS: Record<string, string> = {
+	'Prism Launcher': prismLauncher,
+	PolyMC: polymc,
+	ATLauncher: atlauncher,
+	GDLauncher: gdlauncher,
+}
+
+const logo = computed(() => LOGOS[props.name])
+
+// MultiMC gives MM, Custom (foo) gives C.
+const mark = computed(
+	() =>
+		props.name
+			.match(/\p{Lu}/gu)
+			?.slice(0, 2)
+			.join('') ?? props.name.slice(0, 2).toUpperCase(),
+)
+</script>
