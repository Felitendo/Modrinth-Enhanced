+
+/// A launcher instances can be imported from, and where it keeps them.
+#[derive(Debug, Clone, Serialize)]
+pub struct LauncherSuggestion {
+    /// The importer that reads this launcher's instances.
+    pub launcher: String,
+    pub name: String,
+    /// Where it is, or where it would be on this system.
+    pub path: Option<PathBuf>,
+    /// Whether it is actually there.
+    pub installed: bool,
+}
+
+/// The launchers worth offering, with the importer each one is read by.
+///
+/// PolyMC and other MultiMC forks keep their instances the way Prism does, so
+/// that importer reads them as well.
+const SUGGESTED_LAUNCHERS: &[(ImportLauncherType, &str)] = &[
+    (ImportLauncherType::PrismLauncher, "Prism Launcher"),
+    (ImportLauncherType::MultiMC, "MultiMC"),
+    (ImportLauncherType::PrismLauncher, "PolyMC"),
+    (ImportLauncherType::ATLauncher, "ATLauncher"),
+    (ImportLauncherType::GDLauncher, "GDLauncher"),
+    (ImportLauncherType::Curseforge, "CurseForge"),
+];
+
+/// Every launcher that can be imported from, whether it is installed or not:
+/// one that is not still gets the folder it would be in, to start looking from.
+pub fn launcher_suggestions() -> Vec<LauncherSuggestion> {
+    SUGGESTED_LAUNCHERS
+        .iter()
+        .map(|&(launcher, name)| {
+            let installed = installed_path(launcher, name);
+            LauncherSuggestion {
+                launcher: launcher.to_string(),
+                name: name.to_owned(),
+                path: installed
+                    .clone()
+                    .or_else(|| launcher_paths(name).into_iter().next()),
+                installed: installed.is_some(),
             }
-            Some(dirs::document_dir()?.join("curseforge").join("minecraft"))
-        }
-        ImportLauncherType::Unknown => None,
+        })
+        .collect()
+}
+
+/// Where a launcher of this name actually is, if it is installed.
+fn installed_path(r#type: ImportLauncherType, name: &str) -> Option<PathBuf> {
+    let paths = launcher_paths(name);
+
+    // MultiMC is unpacked wherever the player put it, so its own config file is
+    // what tells one of those places from any other folder of that name.
+    if r#type == ImportLauncherType::MultiMC {
+        return paths
+            .into_iter()
+            .find(|path| path.join("multimc.cfg").exists());
+    }
+
+    paths.into_iter().find(|path| path.exists())
+}
+
+/// Everywhere a launcher of this name keeps its data on this system, likeliest
+/// first.
+fn launcher_paths(name: &str) -> Vec<PathBuf> {
+    let data = dirs::data_dir();
+    let home = dirs::home_dir();
+    // Flatpak gives each app a data directory of its own.
+    let flatpak = |app: &str, folder: &str| {
+        home.as_ref().map(|home| {
+            home.join(".var")
+                .join("app")
+                .join(app)
+                .join("data")
+                .join(folder)
+        })
     };
-    let path = path?;
-    if path.exists() { Some(path) } else { None }
+
+    match name {
+        "Prism Launcher" => [
+            data.map(|data| data.join("PrismLauncher")),
+            flatpak("org.prismlauncher.PrismLauncher", "PrismLauncher"),
+        ]
+        .into_iter()
+        .flatten()
+        .collect(),
+        "PolyMC" => [
+            data.map(|data| data.join("PolyMC")),
+            flatpak("org.polymc.PolyMC", "PolyMC"),
+        ]
+        .into_iter()
+        .flatten()
+        .collect(),
+        "MultiMC" => multimc_paths(),
+        "ATLauncher" => data
+            .map(|data| vec![data.join("ATLauncher")])
+            .unwrap_or_default(),
+        "GDLauncher" => data
+            .map(|data| vec![data.join("gdlauncher_next")])
+            .unwrap_or_default(),
+        "CurseForge" => [
+            home.map(|home| home.join("curseforge").join("minecraft")),
+            dirs::document_dir()
+                .map(|docs| docs.join("curseforge").join("minecraft")),
+        ]
+        .into_iter()
+        .flatten()
+        .collect(),
+        _ => Vec::new(),
+    }
 }
 
