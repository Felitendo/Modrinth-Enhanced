 .../ui/settings/display/FeaturesSettings.vue  | 27 ++++++++
 .../src/composables/use-app-settings.ts       |  3 +
 packages/app-lib/src/state/settings.rs        |  3 +
 4 files changed, 91 insertions(+), 9 deletions(-)

