+
+        match error.error.as_str() {
+            "authorization_pending" => return Ok(None),
+            "slow_down" => {
+                if let Some(sign_in) = pending
+                    .iter_mut()
+                    .find(|pending| pending.device_code == device_code)
+                {
+                    sign_in.interval += std::time::Duration::from_secs(5);
+                    sign_in.next_poll = Instant::now() + sign_in.interval;
