From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Modrinth Enhanced <patches@modrinth-enhanced.invalid>
Date: Thu, 17 Sep 2026 14:23:15 +0200
Subject: [PATCH] Keep the settings tabs clear of the app version

The settings tab list is sized to its column with a percentage height,
which WebKitGTK leaves unresolved inside a flex item without a set
height. The list then ran on over the app version at the bottom of the
column instead of scrolling. It fills its column absolutely now, the way
the content beside it already does.
---
 packages/ui/src/components/modal/TabbedModal.vue | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/packages/ui/src/components/modal/TabbedModal.vue b/packages/ui/src/components/modal/TabbedModal.vue
index 689a898..0220702 100644
--- a/packages/ui/src/components/modal/TabbedModal.vue
+++ b/packages/ui/src/components/modal/TabbedModal.vue
@@ -505,7 +505,7 @@ defineExpose({ show, hide, selectedTab, setTab })
 					<nav
 						v-if="layout === 'rail'"
 						ref="sidebarScrollContainer"
-						class="tabbed-modal-scrollbar flex h-full flex-col gap-1 overflow-y-auto overflow-x-hidden overscroll-contain px-3 pb-2"
+						class="tabbed-modal-scrollbar absolute inset-0 flex flex-col gap-1 overflow-y-auto overflow-x-hidden overscroll-contain px-3 pb-2"
 						@scroll="checkSidebarScrollState"
 					>
 						<template v-for="(tab, index) in visibleTabs" :key="index">
@@ -567,7 +567,7 @@ defineExpose({ show, hide, selectedTab, setTab })
 					<nav
 						v-else-if="isMobile"
 						ref="sidebarScrollContainer"
-						class="tabbed-modal-scrollbar flex h-full flex-col gap-4 overflow-y-auto overscroll-contain"
+						class="tabbed-modal-scrollbar absolute inset-0 flex flex-col gap-4 overflow-y-auto overscroll-contain"
 						:style="{ paddingBottom: floatingActionBarShown ? contentBottomPadding : undefined }"
 						@scroll="checkSidebarScrollState"
 					>
@@ -623,7 +623,7 @@ defineExpose({ show, hide, selectedTab, setTab })
 					<div
 						v-else
 						ref="sidebarScrollContainer"
-						class="tabbed-modal-scrollbar -mr-3 flex h-full flex-col gap-1 overflow-y-auto overscroll-contain pb-4 pr-3"
+						class="tabbed-modal-scrollbar absolute inset-0 -mr-3 flex flex-col gap-1 overflow-y-auto overscroll-contain pb-4 pr-3"
 						@scroll="checkSidebarScrollState"
 					>
 						<template v-for="(tab, index) in visibleTabs" :key="index">
