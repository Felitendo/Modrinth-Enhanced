+		defaultMessage: 'Copy code',
+	},
+	opening: {
+		id: 'app.microsoft-login.opening',
+		defaultMessage: 'Opening your browser…',
+	},
+	waiting: {
+		id: 'app.microsoft-login.waiting',
+		defaultMessage: 'Waiting for you to sign in…',
+	},
+	openAgain: {
+		id: 'app.microsoft-login.open-again',
+		defaultMessage: 'Open browser again',
+	},
+	useBuiltInWindow: {
+		id: 'app.microsoft-login.use-built-in-window',
+		defaultMessage: 'Trouble with the browser? Sign in in a window here instead.',
+	},
+	openError: {
+		id: 'app.microsoft-login.open-error',
+		defaultMessage: 'Could not open a browser to sign in with.',
+	},
+	genericError: {
+		id: 'app.microsoft-login.generic-error',
+		defaultMessage: 'Could not sign in to Microsoft.',
+	},
+})
+</script>
