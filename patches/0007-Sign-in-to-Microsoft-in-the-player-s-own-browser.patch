+
+async function openBrowser() {
+	if (opening.value) return
+
+	opening.value = true
+	error.value = ''
+
+	try {
+		flow = await login_browser_begin()
+	} catch (e) {
+		flow = null
+		error.value = messageOf(e, messages.openError)
+	} finally {
