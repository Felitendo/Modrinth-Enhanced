+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn recognises_skin_pages() {
+        assert_eq!(
+            skin_page("https://de.namemc.com/skin/ee40191789e621d3"),
+            Some((SkinSite::Namemc, "ee40191789e621d3".to_string()))
+        );
+        assert_eq!(
+            skin_page("https://laby.net/skins/2322dc180b90075fa936c3408e3776a4"),
+            Some((SkinSite::Laby, "2322dc180b90075fa936c3408e3776a4".to_string()))
+        );
+        assert_eq!(
+            skin_page(
+                "https://crafty.gg/skins/0a08b87a-c813-4b4f-b83b-c856d46f4b23"
+            ),
+            Some((
+                SkinSite::Crafty,
+                "0a08b87a-c813-4b4f-b83b-c856d46f4b23".to_string()
+            ))
+        );
+        assert_eq!(skin_page("https://namemc.com/minecraft-skins"), None);
+        assert_eq!(skin_page("https://crafty.gg/skins/trending"), None);
+        assert_eq!(skin_page("https://example.com/skin/ee40191789e621d3"), None);
+    }
+}
