 .../src/components/ui/modal/AppSettingsModal.vue            | 2 +-
 apps/app-frontend/src/locales/en-US/index.json              | 2 +-
 apps/app/tauri.conf.json                                    | 6 +++---
 apps/app/tauri.linux.conf.json                              | 2 +-
 apps/app/tauri.macos.conf.json                              | 2 +-
 6 files changed, 8 insertions(+), 8 deletions(-)

