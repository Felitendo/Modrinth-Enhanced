+        return Err(crate::ErrorKind::InputError(
+            "An Ely.by account name and password are both required".to_string(),
+        )
+        .into());
+    }
+
+    let state = State::get().await?;
+    let credentials = Credentials::ely(username, password).await?;
+    credentials.upsert(&state.pool).await?;
