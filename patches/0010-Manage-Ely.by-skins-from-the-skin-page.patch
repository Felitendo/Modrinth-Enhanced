+				<Button type="colored" color="brand" :disabled="!changed" @click="save">
+					<CheckIcon v-if="mode === 'new'" />
+					<SaveIcon v-else />
+					{{ formatMessage(mode === 'new' ? messages.add : messages.save) }}
