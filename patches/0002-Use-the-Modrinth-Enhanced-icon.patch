diff --git a/apps/app/icons/modrinth-enhanced.svg b/apps/app/icons/modrinth-enhanced.svg
new file mode 100644
index 0000000..d61bdc1
--- /dev/null
+++ b/apps/app/icons/modrinth-enhanced.svg
@@ -0,0 +1,58 @@
+<!--
+	Source for every generated icon next to this file. Render them with
+	scripts/render-icons.py after changing anything here.
+
+	The Modrinth mark on Modrinth's dark disc, with a sparkle badge marking the
+	build as the enhanced fork. The badge carries its own dark outline rather
+	than sitting in a punched-out circle, so the mark's ring stays readable
+	behind it.
+-->
+<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512" fill="none">
+	<defs>
+		<linearGradient id="mark" x1="110" y1="60" x2="400" y2="450" gradientUnits="userSpaceOnUse">
+			<stop offset="0" stop-color="#42E887" />
+			<stop offset="0.55" stop-color="#22DC72" />
+			<stop offset="1" stop-color="#17B85A" />
+		</linearGradient>
+		<linearGradient id="spark" x1="340" y1="94" x2="416" y2="172" gradientUnits="userSpaceOnUse">
+			<stop offset="0" stop-color="#FFFFFF" />
+			<stop offset="1" stop-color="#7BF0AC" />
+		</linearGradient>
+		<radialGradient id="disc" cx="0.33" cy="0.27" r="0.92">
+			<stop offset="0" stop-color="#1F232A" />
+			<stop offset="1" stop-color="#121419" />
+		</radialGradient>
+		<radialGradient id="glow" cx="0.5" cy="0.5" r="0.5">
+			<stop offset="0" stop-color="#7BF0AC" stop-opacity="0.45" />
+			<stop offset="0.55" stop-color="#39E183" stop-opacity="0.15" />
+			<stop offset="1" stop-color="#39E183" stop-opacity="0" />
+		</radialGradient>
+	</defs>
+
+	<circle cx="256" cy="256" r="256" fill="url(#disc)" />
+
+	<g transform="translate(25.6 25.6) scale(2.304)" fill="url(#mark)">
+		<path
