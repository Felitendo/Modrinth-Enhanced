+/**
+ * Starts an instance that is already running once more, as the account selected
+ * now, which is how somebody plays one instance on two accounts.
+ */
+const launchAnotherCopy = async (context: string) => {
+	const currentInstance = instance.value
+	if (!currentInstance || currentInstance.quarantined || loading.value || !playing.value) return
+
+	loading.value = true
+	try {
+		await run(currentInstance.id, null, true)
+		await processesQuery.refetch()
+	} catch (err) {
+		handleSevereError(err, { instanceId: currentInstance.id })
+	}
+	loading.value = false
+
+	trackEvent('InstanceStart', {
+		loader: currentInstance.loader,
+		game_version: currentInstance.game_version,
+		source: context,
+	})
+}
