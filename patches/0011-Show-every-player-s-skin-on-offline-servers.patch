-use std::{collections::HashMap, path::Path};
+use std::{
+    collections::HashMap,
+    path::{Path, PathBuf},
+};
 use uuid::Uuid;
 
 // Replaces the space separator with a newline character, as to not split the arguments
 const TEMPORARY_REPLACE_CHAR: &str = "\n";
 
+/// Where the agent in `theseus.jar` looks a skin up when the server sent none.
+///
+/// Ely.by answers by name for its own players, Mojang for the licensed players
+/// Ely.by does not know, and OptiFine only has capes. Each kind of texture goes
+/// to the first source listed that has one, and the player skins folder comes
+/// before all of them.
+pub const SKIN_SOURCES: &str = "https://skinsystem.ely.by,mojang,optifine";
+
+/// What the agent needs to look skins up. Without it the agent leaves skins
+/// exactly as vanilla has them.
+pub struct SkinLookup<'a> {
+    /// Whose skin the game wants first, so it can be fetched ahead of time.
+    pub player_name: &'a str,
+    /// Skins put there by hand, asked before anything on the network.
+    pub local_dir: PathBuf,
+    /// Where answers are kept between runs.
